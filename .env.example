# Mimir Nest - Environment Configuration Template
# Copy this file to .env or create workspace-specific env files (.env.local in apps/web-next, .env in apps/api)

# -----------------------------------------------------------------------------
# Frontend Application (apps/web-next)
# -----------------------------------------------------------------------------
# Primary Express Content API Base URL
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Express Content API Backend (apps/api)
# -----------------------------------------------------------------------------
# Port for the Express backend server
PORT=4000

# Allowed CORS Origin for API requests
CORS_ORIGIN=http://localhost:3000

# Relative path to Content JSON directory (relative to apps/api)
CONTENT_DIR=content
